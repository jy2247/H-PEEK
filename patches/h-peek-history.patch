+    env = os.environ.copy()
+    env.update(
+        {
+            "PEEK_ONLINE_SCHEDULER": "0",
+            "PEEK_ONLINE_EVICTION": "1",
+            "PEEK_ONLINE_CLPM": "0",
+            "PEEK_ONLINE_EVICTION_MODE": "history",
+            "HPEEK_HISTORY_WINDOW": "256",
+            "HPEEK_HISTORY_WEIGHT": "1.0",
+        }
+    )
+    return subprocess.run(
+        [sys.executable, "-c", textwrap.dedent(body)],
+        env=env,
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+
+
+def test_zero_waiting_demand_retains_historically_reused_a():
+    result = _run_history_subprocess(
+        """
+        import peek.online.engines.vllm.patch_hook  # installs history mode
+        from vllm.v1.core.block_pool import BlockPool
