@@ -0,0 +1,93 @@
+"""CPU-only unit tests for H-PEEK's admitted-request history."""
+
+from peek.online.history import HistoricalPrefixTracker, history_protection_score
+
+
+def test_history_keeps_reused_a_when_waiting_demand_is_zero():
+    """Required P1 test: equally evictable A/B should retain historical A."""
+    tracker = HistoricalPrefixTracker(window_size=256)
+    for _ in range(4):
+        tracker.observe(["prefix-A"])
+
+    candidates = ["prefix-A", "prefix-B"]
+    scores = {
+        key: history_protection_score(
+            waiting_demand=0,
+            historical_frequency=tracker.frequency(key),
+            history_weight=1.0,
+            include_waiting=True,
+        )
+        for key in candidates
+    }
+
+    victim = min(candidates, key=scores.__getitem__)
+    assert victim == "prefix-B"
+    assert scores["prefix-A"] > scores["prefix-B"]
+
+
+def test_hotspot_switch_expires_old_prefix():
+    tracker = HistoricalPrefixTracker(window_size=3)
+    tracker.observe(["prefix-A"])
+    tracker.observe(["prefix-A"])
+    tracker.observe(["prefix-A"])
+    tracker.observe(["prefix-B"])
+    tracker.observe(["prefix-B"])
+    tracker.observe(["prefix-B"])
+
+    assert tracker.frequency("prefix-A") == 0
+    assert tracker.frequency("prefix-B") == 3
+
+
+def test_empty_history_has_zero_score_and_clean_fallback_signal():
+    tracker = HistoricalPrefixTracker(window_size=256)
+
+    assert not tracker
+    assert history_protection_score(0, tracker.frequency("missing"), 1.0,
+                                    include_waiting=True) == 0
+
+
+def test_duplicate_hash_counts_once_per_request():
+    tracker = HistoricalPrefixTracker(window_size=256)
+    tracker.observe(["A", "A", "A"])
+
+    assert tracker.frequency("A") == 1
+    assert tracker.snapshot().key_references_in_window == 1
+
+
+def test_window_and_per_request_cap_bound_memory():
+    tracker = HistoricalPrefixTracker(window_size=2, max_keys_per_request=2)
+    tracker.observe(["A", "B", "C"])
+    tracker.observe(["D", "E", "F"])
+    tracker.observe(["G", "H", "I"])
+
+    snapshot = tracker.snapshot()
+    assert snapshot.requests_in_window == 2
+    assert snapshot.key_references_in_window == 4
+    assert snapshot.tracked_keys == 4
+    assert tracker.frequency("A") == 0
+
+
+def test_history_only_ignores_waiting_demand():
+    assert history_protection_score(
+        99, 2, 1.0, include_waiting=False
+    ) == 2
+
+
+def test_min_frequency_gate_ignores_single_request_evidence():
+    assert history_protection_score(
+        0, 1, 1.0, include_waiting=True, min_frequency=2
+    ) == 0
+    assert history_protection_score(
+        0, 2, 1.0, include_waiting=True, min_frequency=2
+    ) == 2
+
+
+def test_kv_cache_group_is_part_of_history_identity():
+    tracker = HistoricalPrefixTracker(window_size=256)
+    raw_hash = b"same-prefix-hash"
+    group_zero = raw_hash + (0).to_bytes(4, "big")
+    group_one = raw_hash + (1).to_bytes(4, "big")
+    tracker.observe([group_zero])
+
+    assert tracker.frequency(group_zero) == 1
+    assert tracker.frequency(group_one) == 0
