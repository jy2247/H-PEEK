index 0000000..5a259ee
--- /dev/null
+++ b/python/peek/online/history.py
@@ -0,0 +1,116 @@
+# Copyright 2026 H-PEEK contributors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+# http://www.apache.org/licenses/LICENSE-2.0
+
+"""Bounded cross-request frequency tracking for H-PEEK.
+
+The tracker intentionally has no wall-clock decay.  It counts how many of the
+last ``window_size`` admitted requests contained a prefix-block key.  This is a
+different signal from PEEK's recency/decay modes, which use a cached block's
+last-access timestamp.
+"""
+
+from __future__ import annotations
+
+from collections import Counter, deque
+from collections.abc import Hashable, Iterable
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class HistorySnapshot:
+    admitted_requests: int
+    requests_in_window: int
+    tracked_keys: int
+    key_references_in_window: int
+
+
+class HistoricalPrefixTracker:
+    """Exact, request-bounded prefix frequency tracker.
+
+    Each call to :meth:`observe` represents one *first admission* of an
+    independent request. Duplicate keys in one request count once. State is
+    bounded by ``window_size * max_keys_per_request`` key references, and keys
+    are removed from the counter as soon as their count reaches zero.
+    """
+
+    def __init__(self, window_size: int, max_keys_per_request: int = 4096) -> None:
+        if window_size <= 0:
+            raise ValueError("window_size must be positive")
+        if max_keys_per_request <= 0:
+            raise ValueError("max_keys_per_request must be positive")
+        self.window_size = window_size
+        self.max_keys_per_request = max_keys_per_request
+        self._window: deque[tuple[Hashable, ...]] = deque()
+        self._counts: Counter[Hashable] = Counter()
+        self._admitted_requests = 0
+        self._key_references = 0
+
+    def observe(self, keys: Iterable[Hashable]) -> None:
+        """Record the unique prefix-block keys of one admitted request."""
+        unique = tuple(dict.fromkeys(keys))
+        if len(unique) > self.max_keys_per_request:
+            unique = unique[: self.max_keys_per_request]
+
+        self._window.append(unique)
+        self._counts.update(unique)
+        self._admitted_requests += 1
+        self._key_references += len(unique)
+
+        if len(self._window) > self.window_size:
+            expired = self._window.popleft()
+            self._key_references -= len(expired)
+            for key in expired:
+                remaining = self._counts[key] - 1
+                if remaining <= 0:
+                    del self._counts[key]
+                else:
+                    self._counts[key] = remaining
+
+    def frequency(self, key: Hashable) -> int:
+        return self._counts.get(key, 0)
+
+    def clear(self) -> None:
+        self._window.clear()
+        self._counts.clear()
+        self._key_references = 0
+
+    def snapshot(self) -> HistorySnapshot:
+        return HistorySnapshot(
+            admitted_requests=self._admitted_requests,
+            requests_in_window=len(self._window),
+            tracked_keys=len(self._counts),
+            key_references_in_window=self._key_references,
+        )
+
+    def __bool__(self) -> bool:
+        return bool(self._counts)
+
+    def __len__(self) -> int:
+        return len(self._counts)
+
+
+def history_protection_score(
+    waiting_demand: int,
+    historical_frequency: int,
+    history_weight: float,
+    *,
+    include_waiting: bool,
+    min_frequency: int = 1,
+) -> float:
+    """Return the H-PEEK score, optionally ignoring weak history evidence."""
+    if waiting_demand < 0 or historical_frequency < 0:
+        raise ValueError("demand and frequency must be non-negative")
+    if history_weight < 0:
+        raise ValueError("history_weight must be non-negative")
+    if min_frequency <= 0:
+        raise ValueError("min_frequency must be positive")
+    waiting = waiting_demand if include_waiting else 0
+    historical = (
+        historical_frequency if historical_frequency >= min_frequency else 0
+    )
+    return waiting + history_weight * historical
